{
    "rewrites": [
        {
            "source": "/quote-:slug.html",
            "destination": "/quote-:slug.html"
        },
        {
            "source": "/observation-agreement-:slug.html",
            "destination": "/observation-agreement-:slug.html"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "functions": {
        "api/cron-sleep-mode.ts": {
            "maxDuration": 300
        },
        "api/cron-booking-reminders.ts": {
            "maxDuration": 60
        },
        "api/cron-swarm-tick.ts": {
            "maxDuration": 300
        }
    },
    "crons": [
        {
            "path": "/api/cron-sleep-mode",
            "schedule": "0 3 * * *"
        },
        {
            "path": "/api/cron-booking-reminders",
            "schedule": "*/15 * * * *"
        },
        {
            "path": "/api/cron-swarm-tick",
            "schedule": "0 * * * *"
        }
    ]
}
